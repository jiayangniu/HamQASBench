# Publication allowlist: new top-level components require deliberate review.
/*
!/.gitignore
!/README.md
!/environment.yml
!/main.py
!/bench_utils.py
!/analyze_critical_structure.py
!/RLQAS/
!/QuantumDARTS/
!/TFQAS/
!/GQEQAS/
!/configs/
!/metrics/
!/mol_gen/
!/analysis/
!/critical_structure_tool/
!/artifact/
!/docs/
!/scripts/
!/tests/

# Only small reference metadata belongs in the artifact directory.
/artifact/*
!/artifact/README.md
!/artifact/gen_manifest.py
!/artifact/instances.csv
!/artifact/instances.json
!/artifact/mol_data.sha256

# Runtime data, plots, checkpoints and machine-local files (also in source dirs).
__pycache__/
*.py[cod]
*.npz
*.npy
*.pt
*.pth
*.ckpt
*.pkl
*.pickle
*.h5
*.hdf5
*.log
*.out
*.err
*.csv
*.tsv
*.pdf
*.png
*.svg
*.jpg
*.zip
*.tar
*.tar.gz
*.tgz
*.bak
*.tmp
*.sh
*.slurm
*.sbatch
* copy.cfg
.env
.env.*
*.pem
*.key
.DS_Store
.vscode/
.idea/
.claude/
.codex/
.venv/
venv/
wandb/
results/
results_local/
figures/
figure/
critical_structure_analysis/
gate_bias_analysis/
provenance*/
PA_SWEEP*/
